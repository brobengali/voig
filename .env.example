# Server Configuration
PORT=4310
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173

# Google Gemini API (Required - obtain from Google AI Studio)
GEMINI_API_KEY=
GEMINI_API_VERSION=v1
GEMINI_MODEL_TRANSCRIBE=gemini-3.5-transcribe
GEMINI_MODEL_CRITIC=gemini-4-hydrogen
GEMINI_MODEL_SYNTHESIS=gemini-4-carbon

# Security Secrets (auto-generated into .env or supply your own 32+ byte hex secrets)
SESSION_SECRET=
ROOM_TOKEN_SECRET=

# Vault & Upload Limits
VAULT_DATA_DIR=./vault_data
MAX_UPLOAD_MB=100
SESSION_TTL_HOURS=12
ROOM_TOKEN_TTL_HOURS=24
